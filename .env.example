# 이 파일을 .env 로 복사한 뒤 가지고 있는 키만 채우세요.
# 키가 없는 AI는 토론에서 자동으로 빠집니다 (최소 2개 필요).

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- 선택 사항 ----
# 기본 모델 (화면에서도 참여자마다 바꿀 수 있습니다)
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6.2-astra
# GEMINI_MODEL=gemini-4-carbon

# Claude 사고 깊이: low | medium | high | xhigh | max (기본 medium)
# CLAUDE_EFFORT=medium
# Claude가 답변을 거절하면 서버 쪽 대체 모델로 이어서 답하게 함 (기본 켜짐, 끄려면 false)
# CLAUDE_REFUSAL_FALLBACK=true

# GPT 추론 강도 (모델이 지원하는 값만: low | medium | high ...). 비워 두면 모델 기본값
# OPENAI_REASONING_EFFORT=

# 서버 주소. 기본은 내 컴퓨터에서만 접속 가능(127.0.0.1)
# PORT=3000
# HOST=127.0.0.1

# true 로 두면 API 키 없이 가짜 응답으로 화면만 시험해 볼 수 있습니다
# MOCK_MODE=false
